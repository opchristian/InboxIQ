# Copy this file to `.env` and replace the placeholder with your real key.
# Example: OPENAI_API_KEY=sk-proj-xxxxxxxx (paste from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Optional Gmail OAuth (live inbox): download the OAuth client JSON from Google Cloud Console,
# rename it to credentials.json, and place it in the project root. Never commit credentials.json or token.json.
# See README section “Live Gmail Sync Setup”.
